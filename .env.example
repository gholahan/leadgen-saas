# ─────────────────────────────────────────────
# LeadGen SaaS — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────


# ── App ───────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# ── Database ──────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/leadgen


# ── Redis ─────────────────────────────────────
# Used as Celery broker and result backend
REDIS_URL=redis://localhost:6379/0


# ── JWT ───────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
SECRET_KEY=changeme
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ── Supabase ──────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>


# ── Object Storage (Neon / S3-compatible) ─────
AWS_ENDPOINT_URL_S3=https://<your-s3-compatible-endpoint>
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>
AWS_REGION=us-east-2


# ── Google OAuth (optional) ───────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── Lead Enrichment Providers (optional) ──────
# At least one enrichment provider is recommended
PROSPEO_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
FINDYMAIL_API_KEY=

# Apify — used for lead scraping/discovery
APIFY_API_KEY=


# ── AI Providers (optional) ───────────────────
# Used for lead scoring, classification, and personalization
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=


# ── Email Providers ───────────────────────────
# Brevo is the active transactional email provider
BREVO_API_KEY=

# Resend (alternative)
RESEND_API_KEY=

# SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
